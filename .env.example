# Copy this to `.env` in the repo root ON THE SERVER (never commit the
# real .env — it's already gitignored). docker-compose.yml reads it via
# env_file. The CI/deploy pipeline never touches this file; it's set up
# once by hand as part of first-time server setup (see DEPLOY.md).

# --- Required ---

# NextAuth needs this to know its own canonical URL when building OAuth
# redirect links — the exact https address nginx serves the app at (see
# deploy/decal.nginx.conf), and must exactly match an Authorized redirect
# URI on the Google OAuth client below.
NEXTAUTH_URL=https://decal.yourdomain.com

# A long random secret NextAuth uses to sign session tokens. Generate one
# with: openssl rand -base64 32
NEXTAUTH_SECRET=

# From Google Cloud Console → Credentials → your OAuth 2.0 Client ID.
# Authorized JavaScript origin and redirect URI both need to be
# NEXTAUTH_URL (and NEXTAUTH_URL + /api/auth/callback/google) exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---

# Your local timezone (affects "today"/date-boundary logic server-side).
# docker-compose.yml defaults this to America/New_York if unset here.
TZ=America/New_York

# Enables the natural-language Quick Add parser (e.g. "dentist next
# Tuesday at 3pm"). Leave unset and Quick Add still works via chrono-node's
# plain date-string parsing — just without free-form phrasing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
